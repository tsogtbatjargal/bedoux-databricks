          <mxGeometry x="10" y="558" width="1090" height="20" as="geometry" />
        </mxCell>

        <!-- background track panels (painted first = behind) -->
        <mxCell id="bg1" value="Track 1 &#8212; TPC-H Medallion&#xa;(classic DE benchmark, done right)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7ff;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=center;fontSize=14;fontStyle=1;spacingTop=14;" vertex="1" parent="1">
