        <!-- Genie -->
        <mxCell id="genie1" value="Genie: TPC-H Medallion Analytics&#xa;natural-language queries over workspace.gold.*&#xa;space_id 01f18c57fa251338962ee7a34efab97e" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
