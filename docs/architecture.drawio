          <mxGeometry x="60" y="390" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="caption1" value="orchestrated by tpch_medallion_pipeline_job&#xa;(sequential: bronze &#8594; silver &#8594; gold)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="260" height="40" as="geometry" />
        </mxCell>

        <!-- Track 2 pipeline chain -->
        <mxCell id="bronze2" value="bedoux_bronze_pipeline&#xa;workspace.bedoux_bronze&#xa;seeded synthetic generator (5 entities)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
