        </mxCell>
        <mxCell id="bg2" value="Track 2 &#8212; Bedoux Ops &amp; Marketing&#xa;(brand-tied, fictional synthetic data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4ea;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=center;fontSize=14;fontStyle=1;spacingTop=14;" vertex="1" parent="1">
