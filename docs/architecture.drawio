        <mxCell id="warehouse" value="SQL Warehouse&#xa;2X-Small &#183; shared (Free Edition limit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="600" width="540" height="50" as="geometry" />
